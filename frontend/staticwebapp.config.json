{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/unauthorized.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/assets/styles.css", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*", "allowedRoles": ["gjv_reviewer"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=/", "statusCode": 302 },
    "403": { "rewrite": "/unauthorized.html" }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/unauthorized.html"]
  },
  "platform": { "apiRuntime": "python:3.11" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "X-Frame-Options": "DENY"
  }
}
