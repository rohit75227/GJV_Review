{
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/140f33a7-c4ac-4479-b593-498d9531d29e/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/api/GetRoles",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/403.html",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/users/*",
      "allowedRoles": [
        "tb_admin"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/users",
      "allowedRoles": [
        "tb_admin"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/me",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/data/*",
      "allowedRoles": [
        "reader"
      ],
      "headers": {
        "Cache-Control": "private, max-age=120, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "allowedRoles": [
        "reader"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/",
      "allowedRoles": [
        "reader"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/*",
      "allowedRoles": [
        "reader"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/data/*",
      "/.auth/*",
      "/api/*",
      "/403.html"
    ]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    },
    "403": {
      "statusCode": 403,
      "rewrite": "/403.html"
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".html": "text/html"
  }
}
